generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CLIENT
  ADVOCATE
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AvailabilityStatus {
  OPEN
  BOOKED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CLIENT)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientAppointments Appointment[] @relation("ClientAppointments")
  advocateAppointments Appointment[] @relation("AdvocateAppointments")
  availability Availability[] @relation("AdvocateAvailability")

  @@map("users")
}

model Availability {
  id        String              @id @default(uuid()) @db.Uuid
  advocateId String             @db.Uuid
  startsAt  DateTime
  endsAt    DateTime
  status    AvailabilityStatus  @default(OPEN)
  timezone  String              @default("UTC")
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  advocate User @relation("AdvocateAvailability", fields: [advocateId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([advocateId, startsAt])
  @@map("availabilities")
}

model Appointment {
  id            String        @id @default(uuid()) @db.Uuid
  clientId      String        @db.Uuid
  advocateId    String        @db.Uuid
  availabilityId String        @db.Uuid
  caseId        String?       @db.Uuid
  status        BookingStatus @default(PENDING)
  title         String
  description   String?
  scheduledAt   DateTime
  endAt         DateTime
  amount        Decimal?      @db.Decimal(10, 2)
  currency      String        @default("USD")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client      User @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Cascade)
  advocate    User @relation("AdvocateAppointments", fields: [advocateId], references: [id], onDelete: Cascade)
  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Restrict)
  payment     Payment?
  history     AppointmentStatusHistory[]

  @@index([advocateId, scheduledAt])
  @@index([clientId, status])
  @@index([caseId])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String        @id @default(uuid()) @db.Uuid
  appointmentId String        @db.Uuid
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  actorUserId   String?       @db.Uuid
  actorType     String        @default("SYSTEM")
  reason        String?
  createdAt     DateTime      @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId, createdAt])
  @@map("appointment_status_history")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  appointmentId   String        @unique @db.Uuid
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  provider        String?
  transactionId   String?       @unique
  paymentIntentId String?       @unique
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@map("payments")
}
